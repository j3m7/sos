# Optional per-machine build settings. Copy to local.cmake (git-ignored) and fill in what you need.
#
# This file holds no device configuration (Wi-Fi, keys): nothing of that kind is compiled into
# the firmware. See provision.conf.example for setting up a board from this machine.

# Optional: use existing wolfSSL / wolfSSH checkouts instead of the lib/ submodules
# (they must be at the versions pinned by the submodules).
# set(WOLFSSL_ROOT "/path/to/wolfssl")
# set(WOLFSSH_ROOT "/path/to/wolfssh")
