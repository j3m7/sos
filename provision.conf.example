# A board's configuration, written by `ninja -C build provision` (tools/provision.sh).
# Copy to provision.conf (git-ignored) and fill in. Lines are "name = value".
#
# This is the automated way to set up a board (the other is `setup` on its console): nothing
# here is compiled into the firmware. Provisioning replaces everything saved on the board,
# so list all you want it to have; what's left out gets its default.

# Wi-Fi network to join (2.4 GHz, WPA2 personal). No password line: an open network.
wifi_ssid = my-network
wifi_password = my-password
# More networks, up to 5 in all: each wifi_ssid starts one, and the wifi_password after it is
# its password. The board joins the first one in reach, in this order.
# wifi_ssid = my-phone
# wifi_password = another-password

# Hostname sent with DHCP requests (default: sos).
hostname = sos

# SSH login: the public keys to trust, one authorized_keys line each (ssh-ed25519 or
# ecdsa-sha2-nistp256), up to 8. Any user name logs in with a trusted key. (An ssh_user line,
# from older files, is still accepted; only firmware from before this change uses it.)
ssh_key = ssh-ed25519 AAAA... user@host

# The console password: asked for before the serial console takes any command. It travels in
# the provisioning image in the clear (the board turns it into a verifier and erases the image's
# copy at its first boot), and it stays in this file on this machine: keep the file private. Without this line the board asks for a
# new password the first time someone uses its console. 8 to 64 characters.
# console_password = choose-a-password

# Optional:
# wifi_country = US              (two letters: the radio rules to follow; default worldwide)
# wifi_powersave = on            (default off)
# nts_server = time.example.org  (default: the firmware's SOS_NTS_SERVER)
# nts_sync_hours = 24            (periodic clock sync; default 0 = off)
# glitch_detector = watch 3      (glitch detector: "off"; a sensitivity 0-3, armed: a trigger resets
#                                 the board; or "watch" and a sensitivity: a trigger is only
#                                 logged. Default: armed at 3, the highest)
# rtc_cal_ppm = 92               (how fast the RTC runs, in ppm; negative: slow; default 0)
