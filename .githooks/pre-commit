#
# Refuses a commit whose generated files are stale, or whose shell scripts shellcheck finds
# fault with. Enabled once per clone with
#
#   git config core.hooksPath .githooks
#
# (docs/development.md, "Git hooks"). It checks what is staged, not the working tree, and only
# when the commit touches the files involved. `git commit --no-verify` skips it.

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMRD)

# The manual pages: man/pages.bundle and docs/commands.md are built from man/*.txt by
# tools/man-bundle.sh, and `man install` downloads the bundle from GitHub as committed.
if grep -qE '^(man/|docs/commands\.md$|tools/man-bundle\.sh$|tools/man-docs\.py$)' <<<"$staged"; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    git ls-files -z -- man docs/commands.md tools/man-bundle.sh tools/man-docs.py |
        git checkout-index -z --stdin --prefix="$tmp/"
    if ! out=$(bash "$tmp/tools/man-bundle.sh" --check 2>&1); then
        echo "$out" >&2
        echo >&2
        echo "pre-commit: the manual pages' generated files don't match the staged pages." >&2
        echo "Run tools/man-bundle.sh, then git add man/pages.bundle docs/commands.md." >&2
        exit 1
    fi
fi

# The time zone bundle: tz/zones.bundle is built by tools/tz-bundle.sh from the release in
# tz/VERSION (which needs the network, so the hook only checks it): its header must name that
# release and every line must be well formed and fit the board's config fields.
if grep -qE '^(tz/|tools/tz-bundle\.sh$)' <<<"$staged"; then
    tzc=$(mktemp -d)
    trap 'rm -rf "${tmp:-}" "$tzc"' EXIT
    git ls-files -z -- tz tools/tz-bundle.sh | git checkout-index -z --stdin --prefix="$tzc/"
    if ! out=$(bash "$tzc/tools/tz-bundle.sh" --check 2>&1); then
        echo "$out" >&2
        echo >&2
        echo "pre-commit: tz/zones.bundle doesn't match tz/VERSION or isn't well formed." >&2
        echo "Run tools/tz-bundle.sh, then git add tz/zones.bundle." >&2
        exit 1
    fi
fi

# Shell scripts: shellcheck (tools/lint-shell.sh) on the staged versions, when the commit touches
# a script or .shellcheckrc. Skipped, with a note, where shellcheck isn't installed.
if grep -qE '(\.sh$|^\.githooks/|^tools/host/pico-vm-attach$|^\.shellcheckrc$)' <<<"$staged"; then
    if command -v shellcheck >/dev/null; then
        sc=$(mktemp -d)
        trap 'rm -rf "${tmp:-}" "${tzc:-}" "$sc"' EXIT
        git checkout-index -a --prefix="$sc/"
        if ! out=$(bash "$sc/tools/lint-shell.sh" "$sc" 2>&1); then
            echo "$out" >&2
            echo >&2
            echo "pre-commit: shellcheck found problems in the staged scripts (above)." >&2
            exit 1
        fi
    else
        echo "pre-commit: shellcheck isn't installed; the shell scripts weren't checked." >&2
    fi
fi
