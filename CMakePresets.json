{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Pico 2 W (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Pico 2 W (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "minsize",
      "displayName": "Pico 2 W (smallest image)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-minsize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "minsize", "configurePreset": "minsize" }
  ]
}
