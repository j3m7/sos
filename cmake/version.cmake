# Writes OUT: a C file defining sos_version, the commit the firmware is built from. Run at every
# build (see the sos_version target in CMakeLists.txt), so the hash follows checkouts and commits
# without re-running cmake. OUT is rewritten only when the text changes, so an unchanged tree
# doesn't relink.
#
#   cmake -DSRC=<source dir> -DOUT=<file> -P version.cmake
#
# The version is a 12-digit commit hash, with "-dirty" when tracked files (or submodules) differ
# from that commit, or "unknown" outside a git checkout. It names the SOS commit only:
#   - Untracked files don't count (a new source file is only built once a tracked CMakeLists.txt
#     lists it, which makes the tree dirty anyway).
#   - In-tree submodules count, with untracked content in them, even when local.cmake takes that
#     library from elsewhere; libraries taken from outside the tree (*_ROOT) are not covered.

find_package(Git QUIET)
set(version "unknown")
if (GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} -C ${SRC} describe --always --dirty --abbrev=12 --exclude=*
        OUTPUT_VARIABLE out
        RESULT_VARIABLE rc
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if (rc EQUAL 0 AND out)
        set(version "${out}")
    endif()
endif()

set(text "// Generated by cmake/version.cmake at build time. Do not edit.\n#include \"core/version.h\"\n\nconst char sos_version[] = \"${version}\";\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
